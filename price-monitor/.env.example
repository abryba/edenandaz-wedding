# ----- Supabase -----
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: SERVER-SIDE ONLY. Used by the scraper job and admin writes.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Resend (email) -----
# Found in: resend.com > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender. Must be a domain/address verified in Resend.
ALERT_FROM_EMAIL=price-alerts@yourcompany.com

# ----- Admin UI access -----
# Simple shared password gate for the internal admin UI.
ADMIN_PASSWORD=change-me-to-something-strong

# ----- Scraper behaviour -----
# Optional: set to "true" to scrape + report WITHOUT sending email or writing snapshots.
DRY_RUN=false
